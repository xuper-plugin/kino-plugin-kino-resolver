{
  "id": "kino-resolver",
  "name": "Kino Resolver",
  "version": "0.0.37",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Universal hoster/embed resolver + deobfuscator for Kino plugins (Kodi ports and native). Opens the door \"resolver\".",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-kino-resolver",
  "hosts": [],
  "fetchHosts": "any",
  "browser": "pages",
  "capabilities": [
    "resolve",
    "search",
    "screen"
  ],
  "screen": {
    "label": "Resolver",
    "labelEn": "Resolver",
    "icon": "link",
    "menuOpens": "screen",
    "opensFrom": [
      "menu"
    ]
  },
  "settings": [
    {
      "key": "seedUrl",
      "type": "url",
      "label": "URL para probar (opcional)",
      "labelEn": "Test URL (optional)",
      "hint": "Pega un enlace; la pantalla lo abre precargado. Opcional.",
      "hintEn": "Paste a link; the screen opens with it prefilled. Optional."
    }
  ],
  "provides": {
    "resolver": {
      "summary": "Resolve hoster embeds to streams, unpack JS, normalize and rank hosters",
      "calls": {
        "resolve": {
          "in": {
            "url": "string",
            "referer": "string?"
          },
          "out": "StreamSet"
        },
        "unpack": {
          "in": {
            "code": "string"
          },
          "out": "Unpacked"
        },
        "normalizeHost": {
          "in": {
            "url": "string"
          },
          "out": "NormalizedHost"
        },
        "rank": {
          "in": {
            "urls": "string[]"
          },
          "out": "Ranking"
        }
      },
      "types": {
        "StreamSet": {
          "streams": "Stream[]",
          "error": "string?"
        },
        "Stream": {
          "url": "string",
          "kind": "string",
          "quality": "string?",
          "lang": "string?",
          "server": "string?",
          "referer": "string?",
          "headers": "Header[]?"
        },
        "Header": {
          "name": "string",
          "value": "string"
        },
        "Unpacked": {
          "code": "string"
        },
        "NormalizedHost": {
          "server": "string",
          "url": "string"
        },
        "Ranking": {
          "scores": "number[]"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "fff66c36c8704f60784f77b7f3bc89d28b2ac04d36a158198235005c060ec7278408d8d07d17352df720beb4c7bc2e23bb5882e537943798bc26bddfdfc5c50f"
  }
}
